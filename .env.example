GROQ_API_KEY=your_groq_api_key_here
REDIS_URL=redis://localhost:6379

# llama-3.1-8b-instant is decommissioned by Groq on 2026-08-16 -
# openai/gpt-oss-20b is their recommended replacement, but its free-tier
# ceiling is much lower (RPD 1,000 / TPD 200K vs. llama-3.1-8b-instant's
# RPD 14,400 / TPD 500K) - re-check console.groq.com/settings/limits.
GROQ_MODEL_CHEAP=openai/gpt-oss-20b
GROQ_MODEL_EXPENSIVE=llama-3.3-70b-versatile

# Free-tier limits per console.groq.com/docs/rate-limits - check your own
# account's Limits page (console.groq.com/settings/limits) and adjust if
# you're on a different plan.
RPM_LIMIT_CHEAP=30
TPM_LIMIT_CHEAP=8000
RPM_LIMIT_EXPENSIVE=30
TPM_LIMIT_EXPENSIVE=12000

MAX_CONCURRENT_REQUESTS=5
CONCURRENCY_QUEUE_TIMEOUT_SECONDS=30
PER_USER_RPM_LIMIT=10

CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

BACKOFF_BASE_SECONDS=1.0
BACKOFF_MAX_RETRIES=3

# Daily token budgets - protects the one shared Groq key (global) and stops
# any single session from hogging it (per-session). Tune to taste.
DAILY_TOKEN_BUDGET_GLOBAL=200000
DAILY_TOKEN_BUDGET_PER_SESSION=20000

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
TOP_K_RETRIEVE=10
TOP_K_RERANK=4

REDIS_CACHE_INDEX_NAME=legal_qa_cache
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95
SEMANTIC_CACHE_TTL_SECONDS=86400

CONVERSATION_MEMORY_TURNS=6
CONVERSATION_MEMORY_TTL_SECONDS=7200

DIFFICULTY_WORD_THRESHOLD=40

# Optional - tracing no-ops cleanly if unset. Free account at cloud.langfuse.com.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional - protects GET /escalations, POST /escalations/{id}/resolve, and
# GET /usage with a shared API key (sent as the X-API-Key header). Unset
# means those endpoints are unauthenticated - fine for local dev, not for
# any shared/public deployment.
ADMIN_API_KEY=
